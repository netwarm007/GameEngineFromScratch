function(run_checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "${ARGV}\n${output}\n${error}")
    endif()
    set(result_output "${output}" PARENT_SCOPE)
endfunction()

run_checked("${PROBE}" --abi)
string(REGEX MATCHALL "[A-Za-z0-9_]+=[0-9]+" cpu_fields "${result_output}")
foreach(field IN LISTS cpu_fields)
    string(REPLACE "=" ";" parts "${field}")
    list(GET parts 0 name)
    list(GET parts 1 value)
    set("cpu_${name}" "${value}")
endforeach()

set(binding_PerFrameConstants ${cpu_binding_perFrame})
set(binding_PerBatchConstants ${cpu_binding_perBatch})
set(binding_LightInfo ${cpu_binding_lightInfo})
set(binding_ShadowMapConstants ${cpu_binding_passConstants})
set(binding_DebugConstants ${cpu_binding_passConstants})
set(textures diffuseMap normalMap metallicMap roughnessMap aoMap heightMap
    brdfLUT shadowMap globalShadowMap cubeShadowMap skybox terrainHeightMap)
set(index 0)
foreach(texture IN LISTS textures)
    math(EXPR "binding_${texture}" "${cpu_binding_textureBase} + ${index}")
    math(EXPR index "${index} + 1")
endforeach()
set(binding_texture_array ${cpu_binding_textureBase})
set(binding_cubemap ${cpu_binding_textureBase})
set(binding_tex ${cpu_binding_textureBase})
set(binding_samp0 ${cpu_binding_samplerBase})
set(binding_img_output ${cpu_binding_storageImageBase})

foreach(shader IN LISTS SHADERS)
    set(binary "${SHADER_DIR}/${shader}.spv")
    run_checked("${SPIRV_VAL}" --target-env vulkan1.1 "${binary}")
    run_checked("${SPIRV_CROSS}" "${binary}" --reflect)
    set(reflection "${result_output}")
    set("reflection_${shader}" "${reflection}")
    set(occupied)
    set(resources)
    foreach(category IN ITEMS ubos separate_images separate_samplers images)
        string(JSON count ERROR_VARIABLE absent LENGTH "${reflection}" "${category}")
        if(absent)
            continue()
        endif()
        math(EXPR last "${count} - 1")
        foreach(i RANGE 0 ${last})
            string(JSON name GET "${reflection}" "${category}" ${i} name)
            list(APPEND resources "${name}")
            string(JSON binding GET "${reflection}" "${category}" ${i} binding)
            string(JSON set GET "${reflection}" "${category}" ${i} set)
            set(expected "${binding_${name}}")
            if(shader STREQUAL "simple.vert")
                set(expected 0)
            elseif(shader STREQUAL "simple.frag")
                if(category STREQUAL "separate_images")
                    math(EXPR expected "${cpu_binding_textureBase} + 1")
                else()
                    math(EXPR expected "${cpu_binding_samplerBase} + 1")
                endif()
            endif()
            if(expected STREQUAL "" OR NOT binding EQUAL expected OR NOT set EQUAL cpu_binding_set)
                message(FATAL_ERROR "${shader}: unexpected ${category} ${name} at ${set}:${binding}, expected ${expected}")
            endif()
            if(binding IN_LIST occupied)
                message(FATAL_ERROR "${shader}: descriptor binding collision at ${binding}")
            endif()
            list(APPEND occupied "${binding}")
            if(category STREQUAL "separate_images")
                string(JSON type GET "${reflection}" "${category}" ${i} type)
                set(expected_type texture2D)
                if(name MATCHES "^(skybox|cubeShadowMap)$" OR shader STREQUAL "cubemaparray.frag")
                    set(expected_type textureCubeArray)
                elseif(name MATCHES "^(shadowMap|globalShadowMap|texture_array)$")
                    set(expected_type texture2DArray)
                elseif(shader STREQUAL "cubemap.frag")
                    set(expected_type textureCube)
                endif()
                if(NOT type STREQUAL expected_type)
                    message(FATAL_ERROR "${shader}: ${name} has type ${type}, expected ${expected_type}")
                endif()
            elseif(category STREQUAL "images")
                string(JSON format GET "${reflection}" "${category}" ${i} format)
                if(NOT format STREQUAL "rgba32f")
                    message(FATAL_ERROR "${shader}: storage output changed from rgba32f to ${format}")
                endif()
            endif()
            if(category STREQUAL "ubos" AND NOT shader STREQUAL "simple.vert")
                string(JSON size GET "${reflection}" ubos ${i} block_size)
                if(NOT size EQUAL cpu_${name}_size)
                    message(FATAL_ERROR "${shader}: ${name} size ${size} differs from C++ ${cpu_${name}_size}")
                endif()
            endif()
        endforeach()
    endforeach()
    set(required)
    if(shader STREQUAL "pbr.vert")
        set(required PerFrameConstants PerBatchConstants)
    elseif(shader STREQUAL "pbr.frag")
        set(required PerFrameConstants LightInfo cubeShadowMap shadowMap
            globalShadowMap diffuseMap metallicMap normalMap skybox brdfLUT samp0)
    elseif(shader STREQUAL "shadowmap_omni.geom")
        set(required ShadowMapConstants)
    elseif(shader STREQUAL "shadowmap_omni.frag")
        set(required ShadowMapConstants LightInfo)
    elseif(shader STREQUAL "shadowmap_omni_metal.vert")
        set(required ShadowMapConstants PerBatchConstants)
    elseif(shader MATCHES "^(integrateBRDF|raytrace).comp$")
        set(required img_output)
    endif()
    if(required)
        list(SORT resources)
        list(SORT required)
        if(NOT resources STREQUAL required)
            message(FATAL_ERROR "${shader}: resources ${resources} differ from ${required}")
        endif()
    endif()
    string(JSON count ERROR_VARIABLE absent LENGTH "${reflection}" types)
    if(NOT absent AND NOT shader STREQUAL "simple.vert")
        math(EXPR last "${count} - 1")
        foreach(i RANGE 0 ${last})
            string(JSON type MEMBER "${reflection}" types ${i})
            string(JSON name GET "${reflection}" types "${type}" name)
            if(NOT DEFINED cpu_${name}_size)
                continue()
            endif()
            string(JSON members LENGTH "${reflection}" types "${type}" members)
            math(EXPR member_last "${members} - 1")
            foreach(j RANGE 0 ${member_last})
                string(JSON member GET "${reflection}" types "${type}" members ${j} name)
                string(JSON offset GET "${reflection}" types "${type}" members ${j} offset)
                if(NOT DEFINED cpu_${name}_${member} OR NOT offset EQUAL cpu_${name}_${member})
                    message(FATAL_ERROR "${shader}: ${name}.${member} offset ${offset} differs from C++ ${cpu_${name}_${member}}")
                endif()
                string(JSON stride ERROR_VARIABLE no_stride GET "${reflection}" types "${type}" members ${j} matrix_stride)
                if(NOT no_stride AND NOT stride EQUAL 16)
                    message(FATAL_ERROR "${shader}: unexpected matrix stride ${stride}")
                endif()
                string(JSON stride ERROR_VARIABLE no_stride GET "${reflection}" types "${type}" members ${j} array_stride)
                if(NOT no_stride)
                    set(expected_stride 16)
                    if(member STREQUAL "lights")
                        set(expected_stride "${cpu_Light_size}")
                    elseif(member STREQUAL "shadowMatrices")
                        set(expected_stride 64)
                    endif()
                    if(NOT stride EQUAL expected_stride)
                        message(FATAL_ERROR "${shader}: ${name}.${member} array stride ${stride} differs from ${expected_stride}")
                    endif()
                endif()
            endforeach()
        endforeach()
    endif()
endforeach()

foreach(pair IN ITEMS "simple.vert|simple.frag" "basic.vert|basic.frag"
    "debug.vert|debug.frag" "pbr.vert|pbr.frag" "skybox.vert|skybox.frag"
    "shadowmap.vert|shadowmap.frag" "shadowmap_omni.geom|shadowmap_omni.frag"
    "shadowmap_omni_metal.vert|shadowmap_omni.frag"
    "passthrough.vert|texture.frag" "passthrough.vert|texturearray.frag"
    "passthrough_cube.vert|cubemap.frag" "passthrough_cube.vert|cubemaparray.frag")
    string(REPLACE "|" ";" stages "${pair}")
    list(GET stages 0 producer)
    list(GET stages 1 consumer)
    string(JSON count ERROR_VARIABLE absent LENGTH "${reflection_${consumer}}" inputs)
    if(absent)
        continue()
    endif()
    math(EXPR last "${count} - 1")
    foreach(i RANGE 0 ${last})
        string(JSON location GET "${reflection_${consumer}}" inputs ${i} location)
        string(JSON type GET "${reflection_${consumer}}" inputs ${i} type)
        string(JSON output_count LENGTH "${reflection_${producer}}" outputs)
        math(EXPR output_last "${output_count} - 1")
        set(found FALSE)
        foreach(j RANGE 0 ${output_last})
            string(JSON output_location GET "${reflection_${producer}}" outputs ${j} location)
            string(JSON output_type GET "${reflection_${producer}}" outputs ${j} type)
            if(location EQUAL output_location AND type STREQUAL output_type)
                set(found TRUE)
            endif()
        endforeach()
        if(NOT found)
            message(FATAL_ERROR "${pair}: incompatible location ${location} (${type})")
        endif()
    endforeach()
endforeach()

foreach(attribute IN ITEMS "0|vec3" "1|vec3" "2|vec2" "3|vec3")
    string(REPLACE "|" ";" parts "${attribute}")
    list(GET parts 0 location)
    list(GET parts 1 expected)
    string(JSON actual_location GET "${reflection_pbr.vert}" inputs ${location} location)
    string(JSON actual_type GET "${reflection_pbr.vert}" inputs ${location} type)
    if(NOT actual_location EQUAL location OR NOT actual_type STREQUAL expected)
        message(FATAL_ERROR "PBR vertex attribute ${location}: expected ${expected}")
    endif()
endforeach()

run_checked("${SPIRV_DIS}" "${SHADER_DIR}/shadowmap_omni_metal.vert.spv")
if(NOT result_output MATCHES "BuiltIn Layer" OR
   NOT result_output MATCHES "OpCapability (ShaderViewportIndexLayerEXT|ShaderLayer)")
    message(FATAL_ERROR "Instanced omni shader lost its vertex-layer capability requirement")
endif()
message(STATUS "Shared Vulkan shader descriptors, C++ layouts, stage interfaces and vertex-layer requirements verified")
