cmake_minimum_required(VERSION 4.0)

get_filename_component(root "." ABSOLUTE)
set(prefix "${root}/External/Windows")
set(cache "${root}/.circleci/windows-deps-cache")
set(key_file "${root}/.circleci/windows-deps-key.txt")
set(complete "${cache}/complete.txt")
set(files "${cache}/files")

if(ACTION STREQUAL "key")
    execute_process(
        COMMAND git ls-files -s -- External/src External/Windows/bin/ispc.exe .gitmodules
        RESULT_VARIABLE result OUTPUT_VARIABLE inputs)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Could not read dependency revisions")
    endif()
    file(GLOB scripts RELATIVE "${root}" "${root}/scripts/build_*.bat")
    list(SORT scripts)
    list(APPEND scripts "scripts/select-vs-generator.bat"
                        ".circleci/config.yml" ".circleci/windows-dependency-cache.cmake")
    foreach(script IN LISTS scripts)
        file(SHA256 "${root}/${script}" hash)
        string(APPEND inputs "\n${script}:${hash}")
    endforeach()
    foreach(tool IN ITEMS cmake python)
        execute_process(COMMAND "${tool}" --version RESULT_VARIABLE result
                        OUTPUT_VARIABLE version ERROR_VARIABLE error)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "Could not read ${tool} version: ${error}")
        endif()
        string(APPEND inputs "\n${tool}:${version}${error}")
    endforeach()

    set(vswhere "$ENV{ProgramFiles\(x86\)}/Microsoft Visual Studio/Installer/vswhere.exe")
    if(NOT EXISTS "${vswhere}")
        message(FATAL_ERROR "vswhere was not found")
    endif()
    execute_process(COMMAND "${vswhere}" -all -prerelease -products "*" -format json
                    RESULT_VARIABLE result OUTPUT_VARIABLE instances)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Could not discover Visual Studio installations")
    endif()
    string(JSON count LENGTH "${instances}")
    if(count EQUAL 0)
        message(FATAL_ERROR "No Visual Studio installation found")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON path GET "${instances}" ${index} installationPath)
        string(JSON version GET "${instances}" ${index} installationVersion)
        string(APPEND inputs "\n${path}:${version}")
        file(GLOB toolsets LIST_DIRECTORIES true "${path}/VC/Tools/MSVC/*")
        list(SORT toolsets)
        string(APPEND inputs "\n${toolsets}")
    endforeach()
    set(sdk "$ENV{ProgramFiles\(x86\)}/Windows Kits/10/Include")
    if(NOT IS_DIRECTORY "${sdk}")
        message(FATAL_ERROR "Windows SDK was not found")
    endif()
    file(GLOB sdk_versions LIST_DIRECTORIES true "${sdk}/*")
    list(SORT sdk_versions)
    cmake_host_system_information(RESULT os QUERY OS_RELEASE OS_VERSION)
    string(APPEND inputs "\n${root}\n${sdk_versions}\n${os}")
    foreach(name IN ITEMS ImageVersion CMAKE_GENERATOR CMAKE_GENERATOR_TOOLSET
                          CMAKE_GENERATOR_PLATFORM CMAKE_PREFIX_PATH CMAKE_TOOLCHAIN_FILE
                          CC CXX CFLAGS CXXFLAGS LDFLAGS INCLUDE LIB LIBPATH
                          VCToolsVersion WindowsSDKVersion VULKAN_SDK)
        string(SHA256 value_hash "$ENV{${name}}")
        string(APPEND inputs "\n${name}:${value_hash}")
    endforeach()
    file(WRITE "${key_file}" "${inputs}")
    message(STATUS "Prepared Windows dependency cache key")
elseif(ACTION STREQUAL "restore")
    if(NOT EXISTS "${complete}")
        message(STATUS "Windows dependency cache miss")
        return()
    endif()
    file(STRINGS "${complete}" cached)
    list(LENGTH cached count)
    if(count LESS 2)
        message(FATAL_ERROR "Windows dependency cache manifest is invalid")
    endif()
    list(POP_FRONT cached cached_key)
    file(SHA256 "${key_file}" current_key)
    if(NOT cached_key STREQUAL current_key)
        message(FATAL_ERROR "Windows dependency cache key does not match")
    endif()
    foreach(relative IN LISTS cached)
        cmake_path(ABSOLUTE_PATH relative BASE_DIRECTORY "${prefix}" NORMALIZE OUTPUT_VARIABLE destination)
        cmake_path(IS_PREFIX prefix "${destination}" NORMALIZE inside)
        if(NOT inside OR NOT EXISTS "${files}/${relative}" OR IS_DIRECTORY "${files}/${relative}")
            message(FATAL_ERROR "Invalid or missing cached dependency: ${relative}")
        endif()
        get_filename_component(directory "${destination}" DIRECTORY)
        file(MAKE_DIRECTORY "${directory}")
        file(COPY_FILE "${files}/${relative}" "${destination}")
    endforeach()
    message(STATUS "Restored Windows dependency cache")
elseif(ACTION STREQUAL "save")
    if(EXISTS "${complete}")
        message(STATUS "Reusing the restored Windows dependency cache")
        return()
    endif()
    set(installed)
    foreach(dependency IN ITEMS crossguid opengex zlib bullet glslang spirv-cross
                                ISPCTextureCompressor openal)
        set(manifest "${root}/External/build/${dependency}/install_manifest.txt")
        if(NOT EXISTS "${manifest}")
            message(FATAL_ERROR "Missing install manifest: ${dependency}")
        endif()
        file(STRINGS "${manifest}" entries)
        list(APPEND installed ${entries})
    endforeach()
    list(APPEND installed "${prefix}/bin/glslangValidator.exe")
    list(REMOVE_DUPLICATES installed)
    list(SORT installed)
    file(SHA256 "${key_file}" key_hash)
    set(manifest "${key_hash}\n")
    foreach(source IN LISTS installed)
        cmake_path(NORMAL_PATH source)
        cmake_path(IS_PREFIX prefix "${source}" NORMALIZE inside)
        if(NOT inside OR NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
            message(FATAL_ERROR "Invalid or missing installed dependency: ${source}")
        endif()
        cmake_path(RELATIVE_PATH source BASE_DIRECTORY "${prefix}" OUTPUT_VARIABLE relative)
        get_filename_component(directory "${files}/${relative}" DIRECTORY)
        file(MAKE_DIRECTORY "${directory}")
        file(COPY_FILE "${source}" "${files}/${relative}")
        string(APPEND manifest "${relative}\n")
    endforeach()
    file(WRITE "${complete}" "${manifest}")
    message(STATUS "Prepared Windows dependency files for caching")
else()
    message(FATAL_ERROR "Expected ACTION=key, restore, or save")
endif()
