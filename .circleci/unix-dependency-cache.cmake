cmake_minimum_required(VERSION 4.0)

# Caches the files installed under External/ by the scripts/build_*.sh
# dependency builds. Usage: cmake -DACTION=key|restore|save -DCONFIG=Release -P ...
if(NOT DEFINED CONFIG)
    set(CONFIG Debug)
endif()
get_filename_component(root "." ABSOLUTE)
set(external "${root}/External")
set(cache "${root}/.circleci/unix-deps-cache-${CONFIG}")
set(key_file "${root}/.circleci/unix-deps-key.txt")
set(archive "${cache}/deps.tar")
set(complete "${cache}/complete.txt")

if(ACTION STREQUAL "key")
    execute_process(
        COMMAND git ls-files -s -- External/src .gitmodules
        RESULT_VARIABLE result OUTPUT_VARIABLE inputs)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Could not read dependency revisions")
    endif()
    file(GLOB scripts RELATIVE "${root}" "${root}/scripts/build_*.sh")
    list(SORT scripts)
    # config.yml is intentionally excluded: CI-only edits must not invalidate
    # the dependency cache. Dependency build inputs are the build scripts,
    # submodule revisions and toolchain hashed here.
    list(APPEND scripts ".circleci/unix-dependency-cache.cmake")
    foreach(script IN LISTS scripts)
        file(SHA256 "${root}/${script}" hash)
        string(APPEND inputs "\n${script}:${hash}")
    endforeach()
    execute_process(COMMAND cmake --version OUTPUT_VARIABLE version)
    string(APPEND inputs "\n${CONFIG}\n${version}")
    foreach(compiler IN ITEMS cc c++)
        execute_process(COMMAND ${compiler} --version RESULT_VARIABLE result
                        OUTPUT_VARIABLE version ERROR_VARIABLE error)
        if(NOT result STREQUAL "0")
            message(FATAL_ERROR "Could not read ${compiler} version: ${error}")
        endif()
        string(APPEND inputs "\n${compiler}:${version}")
    endforeach()
    cmake_host_system_information(RESULT os QUERY OS_NAME OS_RELEASE OS_PLATFORM)
    string(APPEND inputs "\n${os}")
    file(WRITE "${key_file}" "${inputs}")
    message(STATUS "Prepared dependency cache key")
elseif(ACTION STREQUAL "restore")
    if(NOT EXISTS "${complete}" OR NOT EXISTS "${archive}")
        message(FATAL_ERROR "Dependency cache is incomplete")
    endif()
    file(READ "${complete}" cached_key)
    file(SHA256 "${key_file}" current_key)
    if(NOT cached_key STREQUAL current_key)
        message(FATAL_ERROR "Dependency cache key does not match")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
                    WORKING_DIRECTORY "${external}" RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Could not extract the dependency cache")
    endif()
    message(STATUS "Restored dependency cache")
elseif(ACTION STREQUAL "save")
    file(GLOB manifests "${external}/build/*/install_manifest.txt")
    list(SORT manifests)
    if(NOT manifests)
        message(FATAL_ERROR "No install manifests found")
    endif()
    set(installed)
    foreach(manifest IN LISTS manifests)
        file(STRINGS "${manifest}" entries)
        list(APPEND installed ${entries})
    endforeach()
    list(REMOVE_DUPLICATES installed)
    list(SORT installed)
    set(relatives)
    foreach(source IN LISTS installed)
        cmake_path(NORMAL_PATH source)
        cmake_path(IS_PREFIX external "${source}" NORMALIZE inside)
        if(NOT inside)
            message(FATAL_ERROR "Installed file is outside External: ${source}")
        endif()
        if(NOT EXISTS "${source}" AND NOT IS_SYMLINK "${source}")
            message(FATAL_ERROR "Missing installed file: ${source}")
        endif()
        cmake_path(RELATIVE_PATH source BASE_DIRECTORY "${external}" OUTPUT_VARIABLE relative)
        list(APPEND relatives "${relative}")
    endforeach()
    file(MAKE_DIRECTORY "${cache}")
    list(JOIN relatives "\n" list_text)
    file(WRITE "${cache}/files.txt" "${list_text}\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${archive}" "--files-from=${cache}/files.txt"
                    WORKING_DIRECTORY "${external}" RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Could not create the dependency cache")
    endif()
    file(REMOVE "${cache}/files.txt")
    file(SHA256 "${key_file}" key_hash)
    file(WRITE "${complete}" "${key_hash}")
    message(STATUS "Prepared dependency files for caching")
else()
    message(FATAL_ERROR "Expected ACTION=key, restore, or save")
endif()
