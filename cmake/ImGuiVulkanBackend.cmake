include_guard(GLOBAL)

function(myge_prepare_imgui_vulkan_backend output root)
    find_package(Git REQUIRED)
    set(source "${root}/External/src/imgui/backends/imgui_impl_vulkan.cpp")
    file(READ "${source}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(SHA256 source_hash "${content}")
    if(NOT source_hash STREQUAL "29c80defe0f4792a1e13beea28b4907cf05542240d24be45c486b8fe26990344")
        message(FATAL_ERROR "ImGui Vulkan backend changed; review the lifecycle backport before rebuilding")
    endif()
    set(header "${root}/External/src/imgui/backends/imgui_impl_vulkan.h")
    file(READ "${header}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(SHA256 header_hash "${content}")
    if(NOT header_hash STREQUAL "59c6bf3293db5d10fd26f0abe9c6f8653149f3718cef0fbd76a9034a43adb573")
        message(FATAL_ERROR "ImGui Vulkan header changed; review the lifecycle backport before rebuilding")
    endif()
    set(patch "${root}/External/patches/imgui-vulkan-acquire-layout.patch")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${patch}")
    set(directory "${CMAKE_CURRENT_BINARY_DIR}/imgui-vulkan")
    file(MAKE_DIRECTORY "${directory}")
    configure_file("${source}" "${directory}/imgui_impl_vulkan.cpp" COPYONLY)
    configure_file("${header}" "${directory}/imgui_impl_vulkan.h" COPYONLY)
    file(RELATIVE_PATH patch_directory "${root}" "${directory}")
    # Git resolves patch paths from the repository root, even when invoked in a
    # build subdirectory. External build directories may also require ../ paths.
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --unidiff-zero --no-index
        --unsafe-paths "--directory=${patch_directory}" "${patch}"
        WORKING_DIRECTORY "${root}"
        RESULT_VARIABLE result ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Unable to apply ImGui Vulkan lifecycle backport: ${error}")
    endif()
    file(READ "${directory}/imgui_impl_vulkan.cpp" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(SHA256 patched_hash "${content}")
    if(NOT patched_hash STREQUAL "efc0124766304fa15874344f57a3e3d733ff5c38e6b749e491fa7c4e97dd8beb")
        message(FATAL_ERROR "ImGui Vulkan lifecycle backport produced unexpected content")
    endif()
    set_source_files_properties("${directory}/imgui_impl_vulkan.cpp"
        PROPERTIES COMPILE_DEFINITIONS IMGUI_IMPL_VULKAN_NO_PROTOTYPES)
    set(${output} "${directory}/imgui_impl_vulkan.cpp" PARENT_SCOPE)
endfunction()
