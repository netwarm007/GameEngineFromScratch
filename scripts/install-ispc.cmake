cmake_minimum_required(VERSION 4.0)

set(version "1.32.0")
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
cmake_host_system_information(RESULT processor QUERY OS_PLATFORM)

if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows" AND processor MATCHES "AMD64|x86_64")
    set(platform Windows)
    set(package windows.zip)
    set(hash 148d5cd96abe7501c730d5fbd00f1f0c893b96bfeada38d1811c9b6251e86a5c)
    set(executable ispc.exe)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    set(platform Darwin)
    set(package macOS.universal.tar.gz)
    set(hash 9b7bf6cc9fbd8085be267a1d2179fc926e899abf3ded56cd685b4a52f9ee7e98)
    set(executable ispc)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    set(platform Linux)
    set(executable ispc)
    if(processor MATCHES "aarch64|arm64")
        set(package linux.aarch64.tar.gz)
        set(hash ddb892a25ffb2f212a63c59540262556e50cc72b1b0c89bed7735d66da69626d)
    elseif(processor MATCHES "x86_64|AMD64")
        set(package linux.tar.gz)
        set(hash faf266bda2b702d68976ffd26bbd36c1ddba43424cc3c44f25b092cd1aa1f64a)
    else()
        message(FATAL_ERROR "No official ISPC ${version} package for ${processor}")
    endif()
else()
    message(FATAL_ERROR "No official ISPC ${version} package for ${CMAKE_HOST_SYSTEM_NAME}/${processor}")
endif()

set(archive "${root}/External/build/ispc/ispc-v${version}-${package}")
set(destination "${root}/External/${platform}/bin")
set(compiler "${destination}/${executable}")
if(EXISTS "${compiler}")
    execute_process(COMMAND "${compiler}" --version OUTPUT_VARIABLE installed
                    RESULT_VARIABLE result ERROR_QUIET)
    if(result EQUAL 0 AND installed MATCHES "ISPC\\), ${version} ")
        message(STATUS "ISPC ${version} is already installed: ${compiler}")
        return()
    endif()
endif()

file(MAKE_DIRECTORY "${root}/External/build/ispc")
file(DOWNLOAD
    "https://github.com/ispc/ispc/releases/download/v${version}/ispc-v${version}-${package}"
    "${archive}" EXPECTED_HASH "SHA256=${hash}" TLS_VERIFY ON
    STATUS status TIMEOUT 300)
list(GET status 0 code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Could not download official ISPC ${version}: ${status}")
endif()
set(unpacked "${root}/External/build/ispc/unpacked-${version}-${platform}")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${unpacked}")
file(GLOB_RECURSE candidates "${unpacked}/bin/${executable}" "${unpacked}/*/bin/${executable}")
list(LENGTH candidates count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Expected one compiler in official ISPC archive, found ${count}")
endif()
list(GET candidates 0 candidate)
execute_process(COMMAND "${candidate}" --version OUTPUT_VARIABLE installed
                RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT installed MATCHES "ISPC\\), ${version} ")
    message(FATAL_ERROR "Downloaded ISPC compiler did not report version ${version}")
endif()
file(INSTALL "${candidate}" DESTINATION "${destination}" TYPE PROGRAM)
get_filename_component(package_root "${candidate}" DIRECTORY)
get_filename_component(package_root "${package_root}" DIRECTORY)
file(INSTALL "${package_root}/LICENSE.txt" "${package_root}/third-party-programs.txt"
     DESTINATION "${root}/External/ispc/${platform}" TYPE FILE)
message(STATUS "Installed official ISPC ${version}: ${compiler}")
