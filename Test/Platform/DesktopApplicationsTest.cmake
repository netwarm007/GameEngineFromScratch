cmake_minimum_required(VERSION 4.0)

set(work "${BINARY_DIR}/DesktopApplicationsTest")
file(MAKE_DIRECTORY "${work}")
file(COPY "${SOURCE_DIR}/Test/Platform/DesktopApplicationFixture" DESTINATION "${work}")
set(source "${work}/DesktopApplicationFixture")
set(build "${work}/build")
set(prefix "${work}/installed")

function(run_checked)
    execute_process(COMMAND ${ARGV}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}\n${error}")
    endif()
endfunction()

set(configure_args -G "${GENERATOR}" "-DENGINE_SOURCE_DIR=${SOURCE_DIR}")
if(COMPILER)
    list(APPEND configure_args "-DCMAKE_CXX_COMPILER=${COMPILER}")
endif()
if(GENERATOR_PLATFORM)
    list(APPEND configure_args -A "${GENERATOR_PLATFORM}")
endif()
if(GENERATOR_TOOLSET)
    list(APPEND configure_args -T "${GENERATOR_TOOLSET}")
endif()
run_checked("${CMAKE_COMMAND}" -S "${source}" -B "${build}" ${configure_args})
run_checked("${CMAKE_COMMAND}" --build "${build}" --config Debug --target Viewer BilliardGame)
run_checked("${CMAKE_COMMAND}" --install "${build}" --config Debug --prefix "${prefix}")

set(expected_files Scene/splash.ogex Fonts/font.ttf Textures/icon.png
    Materials/splash.mymaterial Materials/baked.pvr Shaders/Vulkan/Engine/pbr.frag.spv)
if(WIN32)
    list(APPEND expected_files Shaders/HLSL/pbr.frag.cso Shaders/OpenGL/pbr.frag.glsl)
elseif(NOT APPLE)
    list(APPEND expected_files Shaders/OpenGL/pbr.frag.glsl)
endif()

function(check_assets root)
    foreach(asset IN LISTS expected_files)
        if(NOT EXISTS "${root}/${asset}")
            message(FATAL_ERROR "Missing packaged asset: ${root}/${asset}")
        endif()
    endforeach()
endfunction()
check_assets("${build}/Asset")
check_assets("${prefix}/Asset")

foreach(app Viewer BilliardGame)
    if(APPLE)
        set(executable "${prefix}/bin/${app}.app/Contents/MacOS/${app}")
        check_assets("${build}/${app}.app/Contents/Resources/Asset")
        check_assets("${prefix}/bin/${app}.app/Contents/Resources/Asset")
        if(NOT EXISTS "${prefix}/bin/${app}.app/Contents/Resources/${app}.metallib")
            message(FATAL_ERROR "Missing ${app} Metal shader library")
        endif()
    elseif(WIN32)
        set(executable "${prefix}/bin/${app}.exe")
    else()
        set(executable "${prefix}/bin/${app}")
    endif()
    run_checked("${executable}")
endforeach()

# A second application build must refresh staged and bundled assets, not just
# pass because the first build happened to provide them.
# CMake install compares timestamps at second resolution, unlike build staging.
run_checked("${CMAKE_COMMAND}" -E sleep 1.1)
file(WRITE "${source}/Asset/Scene/splash.ogex" "updated scene\n")
run_checked("${CMAKE_COMMAND}" --build "${build}" --config Debug --target Viewer BilliardGame)
file(READ "${build}/Asset/Scene/splash.ogex" scene)
if(NOT scene STREQUAL "updated scene\n")
    message(FATAL_ERROR "Build-tree scene was not refreshed")
endif()
run_checked("${CMAKE_COMMAND}" --install "${build}" --config Debug --prefix "${prefix}")
file(READ "${prefix}/Asset/Scene/splash.ogex" scene)
if(NOT scene STREQUAL "updated scene\n")
    message(FATAL_ERROR "Installed scene was not refreshed")
endif()
if(APPLE)
    foreach(app Viewer BilliardGame)
        file(READ "${prefix}/bin/${app}.app/Contents/Resources/Asset/Scene/splash.ogex" scene)
        if(NOT scene STREQUAL "updated scene\n")
            message(FATAL_ERROR "${app} bundle scene was not refreshed")
        endif()
    endforeach()
endif()
