{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 0,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-vs2026",
            "displayName": "Windows - Visual Studio 2026",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/build",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "OPENGL_RHI_DEBUG": "ON",
                "D3D12_RHI_DEBUG": "ON"
            }
        },
        {
            "name": "ninja-debug",
            "displayName": "Ninja Debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ninja-release",
            "displayName": "Ninja Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-vs2026-debug",
            "displayName": "Windows - Visual Studio 2026 Debug",
            "configurePreset": "windows-vs2026",
            "configuration": "Debug"
        },
        {
            "name": "windows-vs2026-release",
            "displayName": "Windows - Visual Studio 2026 Release",
            "configurePreset": "windows-vs2026",
            "configuration": "Release"
        },
        {
            "name": "ninja-debug",
            "displayName": "Ninja Debug",
            "configurePreset": "ninja-debug"
        },
        {
            "name": "ninja-release",
            "displayName": "Ninja Release",
            "configurePreset": "ninja-release"
        }
    ]
}
