{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "viewerProgram",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "Viewer"
            }
        },
        {
            "id": "billiardProgram",
            "type": "command",
            "command": "cmake.launchTargetPath",
            "args": {
                "targetName": "BilliardGame"
            }
        },
        {
            "id": "vulkanRhiTestProgram",
